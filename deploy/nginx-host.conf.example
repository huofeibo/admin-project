server {
    listen 80;
    listen [::]:80;
    server_name huoyb-api.cloud www.huoyb-api.cloud wuji.huoyb-api.cloud;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name huoyb-api.cloud;

    ssl_certificate /etc/nginx/ssl/portfolio/fullchain.crt;
    ssl_certificate_key /etc/nginx/ssl/portfolio/private.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name www.huoyb-api.cloud;

    ssl_certificate /etc/nginx/ssl/portfolio/fullchain.crt;
    ssl_certificate_key /etc/nginx/ssl/portfolio/private.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    return 301 https://huoyb-api.cloud$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name wuji.huoyb-api.cloud;

    ssl_certificate /etc/nginx/ssl/wuji/fullchain.crt;
    ssl_certificate_key /etc/nginx/ssl/wuji/private.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    return 302 https://huoyb-api.cloud/wuji;
}
